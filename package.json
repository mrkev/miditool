    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "nx": "23.3.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.71.2"
  },
  "packageManager": "pnpm@10.19.0"
